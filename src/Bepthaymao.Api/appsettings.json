{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "SePay": { "Mode": "Fake" },
  "Zalo": { "Mode": "Fake" },
  "Kestrel": { "Limits": { "MaxRequestBodySize": 1048576 } },
  "ReverseProxy": { "KnownNetworks": [] },
  "RateLimiting": { "Public": { "PermitLimit": 120, "WindowSeconds": 60 } },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning" }
    }
  }
}
