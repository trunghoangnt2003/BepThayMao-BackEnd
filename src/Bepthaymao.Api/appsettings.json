{
  "Jwt": {
    "Issuer": "bepthaymao",
    "Audience": "bepthaymao-admin",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Auth": { "RefreshCookie": { "Secure": true }, "AllowedOrigins": [] },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "ReverseProxy": {
    "KnownNetworks": []
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "LoginIdentifier": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Public": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    }
  },
  "Serilog": {
    "MinimumLevel": "Information"
  },
  "ConnectionStrings": {
    "Default": "",
    "Redis": "",
    "RabbitMq": ""
  }
}
