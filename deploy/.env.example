# Mẫu cấu hình dev. `npm run dev:up` sao chép thành deploy/.env (bị .gitignore) và tự sinh
# mật khẩu ngẫu nhiên cho các khóa bí mật đang trống. Không ghi giá trị bí mật vào tệp này.

# PostgreSQL
POSTGRES_USER=bepthaymao
POSTGRES_PASSWORD=
POSTGRES_DB=bepthaymao
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=bepthaymao
RABBITMQ_DEFAULT_PASS=
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Cổng vào Traefik (cùng origin cho /api, /admin, /) và API chạy trên máy host
GATEWAY_PORT=8080
API_PORT=5080
# Windows/macOS Docker Desktop: 127.0.0.1. Linux: đặt địa chỉ bridge Docker (vd 172.17.0.1), không dùng 0.0.0.0.
API_BIND_ADDRESS=127.0.0.1

# Tích hợp ngoài: Phase 1 chỉ có bản giả lập (PLAT-03)
SePay__Mode=Fake
Zalo__Mode=Fake

# OpenTelemetry: để trống thì không xuất OTLP
OTEL_EXPORTER_OTLP_ENDPOINT=
